{
  "name": "foodster-ops",
  "version": "0.1.0",
  "private": true,
  "description": "Admin panel for the Foodster operations team: orders, statuses, couriers, audit log",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev-db:up": "docker compose up -d --wait",
    "dev-db:down": "docker compose stop",
    "dev-db:reset": "docker compose --profile test down -v",
    "dev-db:setup": "npm run dev-db:up && npm run db:migrate && npm run db:seed",
    "test-db:up": "docker compose --profile test up -d --wait postgres-test valkey",
    "test-db:setup": "npm run test-db:up",
    "db:generate": "npm run db:generate -w @foodster/api",
    "db:migrate": "npm run db:migrate -w @foodster/api",
    "db:seed": "npm run db:seed -w @foodster/api",
    "dev": "concurrently --names api,web --prefix-colors blue,magenta --kill-others-on-fail \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @foodster/api",
    "dev:web": "npm run dev -w @foodster/web",
    "build": "npm run build -w @foodster/web && npm run build -w @foodster/api",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "concurrently": "10.0.5",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  },
  "overrides": {
    "shell-quote": "1.11.0"
  }
}
