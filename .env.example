# Значения для локального запуска. npm-скрипты (dev, db:migrate, db:seed, test) читают этот файл,
# а затем .env, если он есть: значения из .env важнее, переменные окружения — ещё важнее.
# Копировать файл не нужно; .env — только чтобы что-то переопределить: cp .env.example .env
# Порты, которые публикует docker compose (поменяйте, если заняты локальными сервисами)
DEV_DB_PORT=5432
TEST_DB_PORT=5433
VALKEY_PORT=6379

DATABASE_URL=postgres://foodster:foodster@localhost:5432/foodster
TEST_DATABASE_URL=postgres://foodster:foodster@localhost:5433/foodster_test
REDIS_URL=redis://localhost:6379
# Тесты: тот же Valkey из docker compose, база 1 (ключи и каналы в тестах уникальны)
TEST_REDIS_URL=redis://localhost:6379/1

# API
# Обязательна: development | test | production. Без неё приложение не стартует
NODE_ENV=development
PORT=3000
# Секрет подписи сессий (JWT), не короче 32 символов. В проде — свой случайный: openssl rand -hex 32
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
# Флаг Secure у cookie сессии. По умолчанию true; false — только для локального http://localhost
COOKIE_SECURE=false
# Адреса прокси перед приложением: IP/CIDR через запятую или наборы loopback, linklocal,
# uniquelocal (10/8, 172.16/12, 192.168/16, fc00::/7).
# Локально прокси нет — не задаём. На Render обязателен: по IP клиента ограничивается частота входа.
# Значение выбирается по логам первого деплоя: поля ip, socketAddress, forwardedFor в записях о входе
# TRUST_PROXY=

# Уровень логов: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# Общий пароль всех операторов для seed. Локально можно не задавать (будет foodster-demo);
# в production обязателен, это секрет (env group на Render) и он должен отличаться от локального
# SEED_OPERATOR_PASSWORD=

# --- Лимиты контейнеров (см. docker-compose.yml): PG_* по умолчанию как Postgres на Render Free,
# VALKEY_MAXMEMORY — как память Key Value Free; остальное — наши значения ---
# PG_CPUS=0.1
# PG_MEMORY=256m
# TEST_PG_CPUS=2
# TEST_PG_MEMORY=1g
# VALKEY_CPUS=0.25
# VALKEY_MEMORY=64m
# VALKEY_MAXMEMORY=25mb
