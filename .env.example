# Скопируйте в .env: cp .env.example .env
# Порты, которые публикует docker compose (поменяйте, если заняты локальными сервисами)
DEV_DB_PORT=5432
TEST_DB_PORT=5433
VALKEY_PORT=6379

DATABASE_URL=postgres://foodster:foodster@localhost:5432/foodster
TEST_DATABASE_URL=postgres://foodster:foodster@localhost:5433/foodster_test
REDIS_URL=redis://localhost:6379

# --- Лимиты контейнеров (значения по умолчанию как на Render Free, см. docker-compose.yml) ---
# PG_CPUS=0.1
# PG_MEMORY=256m
# TEST_PG_CPUS=2
# TEST_PG_MEMORY=1g
# VALKEY_CPUS=0.25
# VALKEY_MEMORY=64m
# VALKEY_MAXMEMORY=25mb
