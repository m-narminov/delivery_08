{
  "name": "@foodster/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env.example --env-file-if-exists=../../.env src/server.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=../../.env.example --env-file-if-exists=../../.env src/scripts/migrate.ts",
    "db:seed": "tsx --env-file=../../.env.example --env-file-if-exists=../../.env src/scripts/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/jwt": "^10.2.4",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@foodster/shared": "*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "openapi-types": "^12.1.3",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15"
  }
}
